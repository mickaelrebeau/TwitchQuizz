# Server port (default: 3000)
PORT=3000

# Client origin for CORS (Vite dev server default)
CLIENT_ORIGIN=http://localhost:5173

# Optional: path to client build for "combined" mode (one URL).
# If set, server serves the SPA from this folder (e.g. client/dist).
# Leave unset to use default: <server>/../../client/dist (relative to server dist).
# CLIENT_DIST_PATH=../client/dist

# Twitch chat (required for story 2.1+)
# OAuth token for IRC/chat (format: oauth:xxxx). twitchapps.com/tmi is discontinued.
# Options: 1) Twitch Token Generator (swiftyspiffy) for quick test
#          2) Twitch OAuth: https://dev.twitch.tv/docs/authentication/getting-tokens-oauth/
#          3) Twitch Chat OAuth: https://dev.twitch.tv/docs/irc/authenticate-bot
TWITCH_CHANNEL=your_channel
TWITCH_OAUTH=oauth:...
